# Copy this file to `.env` (next to docker-compose.yml) and fill in what you need.
# Everything here is optional — with all of it blank you get username/password
# login and a self-generated session secret.

# Host port to publish. The container always listens on 3000 internally.
PORT=3000

# Signing key for login sessions. If left blank, the app generates one and
# stores it in the database — but then wiping the data volume logs everyone out.
# Set it to a long random string to keep sessions stable across rebuilds:
#   openssl rand -base64 32
#   node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
SESSION_SECRET=

# --- Email one-time code login (optional) --------------------------------
# Address the 6-digit login code is sent to.
ADMIN_EMAIL=
# Resend API key (https://resend.com). Without it the "Email me a code" button
# is hidden and you sign in with username + password.
RESEND_API_KEY=

# --- Cloudflare Access (optional) ---------------------------------------
# Only if you run the container behind a Cloudflare Tunnel with an Access
# policy. When both are set, a verified Access login is trusted and the app
# skips its own login screen.
ACCESS_TEAM=
ACCESS_AUD=
