{
  "name": "whiskey-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "deploy": "vite build && wrangler deploy",
    "check": "wrangler types && tsc -b",
    "typegen": "wrangler types",
    "db:local": "wrangler d1 migrations apply whiskey-db --local",
    "db:remote": "wrangler d1 migrations apply whiskey-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.7",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.1.1"
  },
  "overrides": {
    "hono": "$hono",
    "sharp": "0.35.5",
    "undici": "7.29.1",
    "source-map-js": "1.2.2"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.0.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.2",
    "vite": "^6.0.5",
    "vitest": "^5.0.0",
    "wrangler": "^4.0.0"
  }
}
